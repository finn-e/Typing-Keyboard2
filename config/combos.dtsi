
#define LOCOMBO(NAME, BINDINGS, KEYPOS) \
combo_l_##NAME { \
    timeout-ms = <COMBO_TIMEOUT>; \
    bindings = <BINDINGS>; \
    key-positions = <KEYPOS>; \
    layers = <COMBO_LAYERS>; \
}; \

#define LTCOMBO(NAME, CENTER_BINDINGS, INNER_BINDINGS, OUTER_BINDINGS, KEYPOS) \
combo_lc_##NAME { \
        timeout-ms = <COMBO_TIMEOUT>; \
        bindings = <CENTER_BINDINGS>; \
        key-positions = <KEYPOS LCT>; \
        layers = <COMBO_LAYERS>; \
}; \
combo_li_##NAME { \
    timeout-ms = <COMBO_TIMEOUT>; \
    bindings = <INNER_BINDINGS>; \
    key-positions = <KEYPOS LIT>; \
    layers = <COMBO_LAYERS>; \
}; \
combo_lo_##NAME { \
    timeout-ms = <COMBO_TIMEOUT>; \
    bindings = <OUTER_BINDINGS>; \
    key-positions = <KEYPOS LOT>; \
    layers = <COMBO_LAYERS>; \
};

#define ROCOMBO(NAME, BINDINGS, KEYPOS) \
combo_r_##NAME { \
    timeout-ms = <COMBO_TIMEOUT>; \
    bindings = <BINDINGS>; \
    key-positions = <KEYPOS>; \
    layers = <COMBO_LAYERS>; \
}; \

#define RTCOMBO(NAME, CENTER_BINDINGS, INNER_BINDINGS, OUTER_BINDINGS, KEYPOS) \
combo_rc_##NAME { \
    timeout-ms = <COMBO_TIMEOUT>; \
    bindings = <CENTER_BINDINGS>; \
    key-positions = <KEYPOS RCT>; \
    layers = <COMBO_LAYERS>; \
}; \
combo_ri_##NAME { \
        timeout-ms = <COMBO_TIMEOUT>; \
        bindings = <INNER_BINDINGS>; \
        key-positions = <KEYPOS RIT>; \
        layers = <COMBO_LAYERS>; \
}; \
combo_ro_##NAME { \
        timeout-ms = <COMBO_TIMEOUT>; \
        bindings = <OUTER_BINDINGS>; \
        key-positions = <KEYPOS ROT>; \
        layers = <COMBO_LAYERS>; \
};

#define TCOMBO(NAME, CENTER_BINDINGS, INNER_BINDINGS, OUTER_BINDINGS, LEFT_KEYPOS, RIGHT_KEYPOS) \
LTCOMBO(##NAME, ##CENTER_BINDINGS, ##INNER_BINDINGS, ##OUTER_BINDINGS, ##LEFT_KEYPOS) \
RTCOMBO(##NAME, ##CENTER_BINDINGS, ##INNER_BINDINGS, ##OUTER_BINDINGS, ##RIGHT_KEYPOS)

#define OCOMBO(NAME, BINDINGS, LEFT_KEYPOS, RIGHT_KEYPOS) \
LOCOMBO(##NAME, ##BINDINGS, ##LEFT_KEYPOS) \
ROCOMBO(##NAME, ##BINDINGS, ##RIGHT_KEYPOS)

#define FCOMBO(NAME, BINDINGS, CENTER_BINDINGS, INNER_BINDINGS, OUTER_BINDINGS, LEFT_KEYPOS, RIGHT_KEYPOS) \
OCOMBO(##NAME, ##BINDINGS, ##LEFT_KEYPOS, ##RIGHT_KEYPOS) \
TCOMBO(##NAME, ##CENTER_BINDINGS, ##INNER_BINDINGS, ##OUTER_BINDINGS, ##LEFT_KEYPOS, ##RIGHT_KEYPOS)

//** COMBOS **//
// Most combos use only Ring, Middle and Index fingers. Pinky is reserved for necessary places (like left, 0 or shift)
LTCOMBO(sk_shift, &as N0, &kp LEFT, &as F10, HLP)
RTCOMBO(sk_shift, &as N0, &kp RIGHT, &as F10, HRP)
//| | | | |
//|x| | | |
//| | | | |

TCOMBO(N, &as N4, &kp DOWN, &as F4, HLR, HRR)
//| | | | |
//| |x| | |
//| | | | |

TCOMBO(E, &as N5, &kp UP, &as F5, HLM, HRM)
//| | | | |
//| | |x| |
//| | | | |

LTCOMBO(T, &as N6, &kp RIGHT, &as F6, HLI)
RTCOMBO(T, &as N6, &kp LEFT, &as F6, HRI)
//| | | | |
//| | | |x|
//| | | | |

LTCOMBO(sk_meta, &as N0, &kp HOME, &as F10, TLP)
RTCOMBO(sk_meta, &as N0, &kp END, &as F10, TRP)
