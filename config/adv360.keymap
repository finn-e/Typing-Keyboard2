#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

&gresc { keep-mods = <(MOD_LSFT|MOD_RSFT)>; };

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <100>;
            require-prior-idle-ms = <100>;
        };

        tl: tapping_layers {
            compatible = "zmk,behavior-hold-tap";
            label = "TAPPING_LAYERS";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            quick-tap-ms = <100>;
            require-prior-idle-ms = <100>;
        };

        u_paste: u_paste {
            compatible = "zmk,behavior-mod-morph";
            label = "U_PASTE";
            bindings = <&tap_u_qu>, <&kp LC(V)>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        p_copy: p_copy {
            compatible = "zmk,behavior-mod-morph";
            label = "P_COPY";
            bindings = <&kp P>, <&kp LC(C)>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        x_cut: x_cut {
            compatible = "zmk,behavior-mod-morph";
            label = "X_CUT";
            bindings = <&kp X>, <&kp LC(X)>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        the: the {
            compatible = "zmk,behavior-mod-morph";
            label = "THE";
            bindings = <&lthe>, <&uThe>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        from: from {
            compatible = "zmk,behavior-mod-morph";
            label = "FROM";
            bindings = <&lfrom>, <&uFrom>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        have: have {
            compatible = "zmk,behavior-mod-morph";
            label = "HAVE";
            bindings = <&lhave>, <&uHave>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        because: because {
            compatible = "zmk,behavior-mod-morph";
            label = "BECAUSE";
            bindings = <&lbecause>, <&uBecause>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        their: their {
            compatible = "zmk,behavior-mod-morph";
            label = "THEIR";
            bindings = <&ltheir>, <&uTheir>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        there: there {
            compatible = "zmk,behavior-mod-morph";
            label = "THERE";
            bindings = <&lthere>, <&uThere>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        theyre: theyre {
            compatible = "zmk,behavior-mod-morph";
            label = "THEYRE";
            bindings = <&ltheyre>, <&uTheyre>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        where: where {
            compatible = "zmk,behavior-mod-morph";
            label = "WHERE";
            bindings = <&lwhere>, <&uWhere>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        will: will {
            compatible = "zmk,behavior-mod-morph";
            label = "WILL";
            bindings = <&lwill>, <&uWill>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        would: would {
            compatible = "zmk,behavior-mod-morph";
            label = "WOULD";
            bindings = <&uWould>, <&uWould>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        aint: aint {
            compatible = "zmk,behavior-mod-morph";
            label = "AINT";
            bindings = <&laint>, <&uAint>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        yall: yall {
            compatible = "zmk,behavior-mod-morph";
            label = "YALL";
            bindings = <&lyall>, <&uYall>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        shant: shant {
            compatible = "zmk,behavior-mod-morph";
            label = "SHANT";
            bindings = <&lshant>, <&uShant>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        layer_rpt: layer_rpt {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_RPT";
            bindings = <&mo>, <&key_repeat>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        tap_u_qu: tap_u_qu {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_U_QU";
            #binding-cells = <0>;
            bindings = <&kp U>, <&qu>;

            tapping-term-ms = <200>;
        };

        qu: qu {
            compatible = "zmk,behavior-mod-morph";
            label = "QU";
            bindings = <&lqu>, <&uQu>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        please: please {
            compatible = "zmk,behavior-mod-morph";
            label = "PLEASE";
            bindings = <&lplease>, <&uPlease>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        thankyou: thankyou {
            compatible = "zmk,behavior-mod-morph";
            label = "THANKYOU";
            bindings = <&lthankyou>, <&uThankYou>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        comma_copy: comma_copy {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_COPY";
            bindings = <&comma_dot>, <&kp LC(C)>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        comma_dot: comma_dot {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_DOT";
            bindings = <&kp COMMA>, <&kp DOT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        rpt_copy: rpt_copy {
            compatible = "zmk,behavior-mod-morph";
            label = "RPT_COPY";
            bindings = <&key_repeat>, <&kp LC(C)>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        test_behavior: test_behavior {
            compatible = "zmk,behavior-hold-tap";
            label = "TEST_BEHAVIOR";
            bindings = <&uQu>, <&lplease>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            retro-tap;
            flavor = "balanced";
        };
    };

    macros {
        ht: ht {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp H &kp T>;
            label = "HT";
        };

        double0: double0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &kp N0>;
            label = "DOUBLE0";
        };

        Th: Th {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(T) &kp H>;
            label = "TH";
        };

        lthe: lthe {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp H &kp E &kp SPACE>;
            label = "LTHE";
        };

        uThe: uThe {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(T) &kp H &kp E &kp SPACE>;
            label = "UTHE";
        };

        lhave: lhave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp H &kp A &kp V &kp E &kp SPACE>;
            label = "LHAVE";
        };

        uHave: uHave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(H) &kp A &kp V &kp E &kp SPACE>;
            label = "UHAVE";
        };

        lfrom: lfrom {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F &kp R &kp O &kp M &kp SPACE>;
            label = "LFROM";
        };

        uFrom: uFrom {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(F) &kp R &kp O &kp M &kp SPACE>;
            label = "UFROM";
        };

        lbecause: lbecause {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp B &kp E &kp C &kp A &kp U &kp S &kp E &kp SPACE>;
            label = "LBECAUSE";
        };

        uBecause: uBecause {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(B) &kp E &kp C &kp A &kp U &kp S &kp E &kp SPACE>;
            label = "UBECAUSE";
        };

        ltheir: ltheir {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp H &kp E &kp I &kp R &kp SPACE>;
            label = "LTHEIR";
        };

        uTheir: uTheir {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(T) &kp H &kp E &kp I &kp R &kp SPACE>;
            label = "UTHEIR";
        };

        lthere: lthere {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp H &kp E &kp R &kp E &kp SPACE>;
            label = "LTHERE";
        };

        uThere: uThere {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(T) &kp H &kp E &kp R &kp E &kp SPACE>;
            label = "UTHERE";
        };

        ltheyre: ltheyre {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp H &kp E &kp Y &kp SQT &kp R &kp E &kp SPACE>;
            label = "LTHEYRE";
        };

        uTheyre: uTheyre {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(T) &kp H &kp E &kp Y &kp SQT &kp R &kp E &kp SPACE>;
            label = "UTHEYRE";
        };

        lwhere: lwhere {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp W &kp H &kp E &kp R &kp E &kp SPACE>;
            label = "LWHERE";
        };

        uWhere: uWhere {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(W) &kp H &kp E &kp R &kp E &kp SPACE>;
            label = "UWHERE";
        };

        lwill: lwill {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp W &kp I &kp L &kp L &kp SPACE>;
            label = "LWILL";
        };

        uWill: uWill {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(W) &kp I &kp L &kp L &kp SPACE>;
            label = "UWILL";
        };

        lwould: lwould {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp W &kp O &kp U &kp L &kp D &kp SPACE>;
            label = "LWOULD";
        };

        uWould: uWould {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(W) &kp O &kp U &kp L &kp D &kp SPACE>;
            label = "UWOULD";
        };

        laint: laint {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp A &kp I &kp N &kp SQT &kp T &kp SPACE>;
            label = "LAINT";
        };

        uAint: uAint {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(A) &kp I &kp N &kp SQT &kp T &kp SPACE>;
            label = "UAINT";
        };

        lyall: lyall {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Y &kp SQT &kp A &kp L &kp L &kp SPACE>;
            label = "LYALL";
        };

        uYall: uYall {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(Y) &kp SQT &kp A &kp L &kp L &kp SPACE>;
            label = "UYALL";
        };

        lshant: lshant {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp H &kp A &kp N &kp SQT &kp T &kp SPACE>;
            label = "LSHANT";
        };

        uShant: uShant {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(S) &kp H &kp A &kp N &kp SQT &kp T &kp SPACE>;
            label = "USHANT";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        land: land {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp A &kp N &kp D>;
            label = "LAND";
        };

        uAnd: uAnd {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(A) &kp N &kp D>;
            label = "UAND";
        };

        lqu: lqu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Q &kp U>;
            label = "LQU";
        };

        uQu: uQu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(Q) &kp U>;
            label = "UQU";
        };

        uPlease: please {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(P) &kp L &kp E &kp A &kp S &kp E>;
            label = "PLEASE";
        };

        lplease: lplease {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp P &kp L &kp E &kp A &kp S &kp E>;
            label = "LPLEASE";
        };

        uThankYou: uThankYou {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(T) &kp H &kp A &kp N &kp K &kp SPACE &kp Y &kp O &kp U>;
            label = "UTHANKYOU";
        };

        lthankyou: lthankyou {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp H &kp A &kp N &kp K &kp SPACE &kp Y &kp O &kp U>;
            label = "LTHANKYOU";
        };
    };

    combos {
        compatible = "zmk,combos";

        hl_u {
            bindings = <&kp U>;
            key-positions = <30 31>;
            layers = <0 2 3 4>;
        };

        hl_m {
            bindings = <&kp M>;
            key-positions = <30 32>;
            layers = <0 2 3 4>;
        };

        hl_g {
            bindings = <&kp G>;
            key-positions = <32 31>;
            layers = <0 2 3 4>;
        };

        hr_u {
            bindings = <&kp U>;
            key-positions = <43 42>;
            layers = <0 2 3 4>;
        };

        hr_m {
            bindings = <&kp M>;
            key-positions = <43 41>;
            layers = <0 2 3 4>;
        };

        hr_g {
            bindings = <&kp G>;
            key-positions = <42 41>;
            layers = <0 2 3 4>;
        };

        bl_y {
            bindings = <&kp Y>;
            key-positions = <48 49>;
        };

        bl_w {
            bindings = <&kp W>;
            key-positions = <48 50>;
        };

        bl_f {
            bindings = <&kp F>;
            key-positions = <49 50>;
        };

        br_y {
