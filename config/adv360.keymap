            key-positions = <11 9>;
        };

        r4r_k {
            bindings = <&kp K>;
            key-positions = <9 10>;
        };

        ul_enter {
            bindings = <&kp ENTER>;
            key-positions = <30 31 32>;
        };

        hr_enter {
