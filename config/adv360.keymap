&none  &none       &trans           &trans        &trans       &none                  &none      &none                  &none  &trans       &trans        &trans           &none       &none
&none  &none       &none            &none         &none               &trans  &trans  &none      &none  &trans  &trans         &none        &none         &none            &none       &none
            >;
        };

        bt {
            display-name = "bt";
            bindings = <
&none  &none         &none         &none         &none           &none  &none                                     &none   &none  &none           &none         &none         &none         &none
&none  &bt BT_SEL 4  &bt BT_PRV    &bt BT_NXT    &bt BT_CLR      &none  &none                                     &none   &none  &bt BT_CLR      &bt BT_PRV    &bt BT_NXT    &bt BT_SEL 4  &none
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3    &none  &none   &none   &none      &none  &none   &none   &none  &bt BT_SEL 3    &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none  &none         &trans        &trans        &bt BT_CLR_ALL  &none                  &none      &none                  &none  &bt BT_CLR_ALL  &trans        &trans        &none         &none
&none  &none         &none         &none         &none                  &trans  &trans  &none      &none  &trans  &trans         &none           &none         &none         &none         &none
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
