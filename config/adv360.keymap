#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        ht: ht {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp H &kp T>;
            label = "HT";
        };

        double0: double0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &kp N0>;
            label = "DOUBLE0";
        };

        Th: Th {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(T) &kp H>;
            label = "TH";
        };
    };

    combos {
        compatible = "zmk,combos";

        hl_period {
            bindings = <&kp PERIOD>;
            key-positions = <32 31>;
        };

        hl_exclam {
            bindings = <&kp EXCLAMATION>;
            key-positions = <32 30>;
        };

        hl_colon {
            bindings = <&kp COLON>;
            key-positions = <32 29>;
        };

        hl_under {
            bindings = <&kp UNDER>;
            key-positions = <31 30>;
        };

        hl_apos {
            bindings = <&kp SQT>;
            key-positions = <30 29>;
        };

        hl_enter {
            bindings = <&kp ENTER>;
            key-positions = <32 31 30>;
        };

        hl_esc {
            bindings = <&gresc>;
            key-positions = <29 30 31>;
        };

        hl_bt-prv {
            bindings = <&bt BT_PRV>;
            key-positions = <29 30 31 32>;
        };

        hr_comma {
            bindings = <&kp COMMA>;
            key-positions = <41 42>;
        };

        hr_question {
            bindings = <&kp QUESTION>;
            key-positions = <41 43>;
        };

        hr_semi {
            bindings = <&kp SEMI>;
            key-positions = <44 41>;
        };

        hr_dash {
            bindings = <&kp MINUS>;
            key-positions = <43 42>;
        };

        hr_enter {
            bindings = <&kp ENTER>;
            key-positions = <43 42 41>;
        };

        hr_esc {
            bindings = <&gresc>;
            key-positions = <42 44 43>;
        };

        hr_bt-nxt {
            bindings = <&bt BT_NXT>;
            key-positions = <44 43 42 41>;
        };

        bl_bspc {
            bindings = <&kp BACKSPACE>;
            key-positions = <49 48>;
        };

        hl_bsl {
            bindings = <&kp BACKSLASH>;
            key-positions = <29 31>;
        };

        hr_slsh {
            bindings = <&kp SLASH>;
            key-positions = <44 42>;
        };

        l_cut {
            bindings = <&kp LC(X)>;
            key-positions = <48 29>;
        };

        l_copy {
            bindings = <&kp LC(C)>;
            key-positions = <29 49>;
        };

        l_paste {
            bindings = <&kp LC(V)>;
            key-positions = <29 50>;
        };

        r_cut {
            bindings = <&kp RC(X)>;
            key-positions = <44 57>;
        };

        r_copy {
            bindings = <&kp RC(C)>;
            key-positions = <44 56>;
        };

        r_paste {
            bindings = <&kp RC(V)>;
            key-positions = <44 55>;
        };

        br_bspc {
            bindings = <&kp BACKSPACE>;
            key-positions = <56 57>;
        };

        tl_paren {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <18 17>;
        };

        tr_paren {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <24 23>;
        };

        tl_brkt {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <16 17>;
        };

        tr_brkt {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <25 24>;
        };

        tl_brc {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <16 15>;
        };

        tr_brc {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <25 26>;
        };

        tl_less {
            bindings = <&kp LESS_THAN>;
            key-positions = <18 16>;
        };

        tr_grtr {
            bindings = <&kp GREATER_THAN>;
            key-positions = <23 25>;
        };

        tl_tilde {
            bindings = <&kp TILDE>;
            key-positions = <17 15>;
        };

        tr_pipe {
            bindings = <&kp PIPE>;
            key-positions = <26 24>;
        };

        tl_equal {
            bindings = <&kp EQUAL>;
            key-positions = <18 15>;
        };

        tr_prt-sc {
            bindings = <&kp PRINTSCREEN>;
            key-positions = <23 26>;
        };

        bl_del {
            bindings = <&kp DELETE>;
            key-positions = <48 50>;
        };

        br_del {
            bindings = <&kp DELETE>;
            key-positions = <57 55>;
        };

        bl_tab {
            bindings = <&kp TAB>;
            key-positions = <50 49>;
        };

        br_tab {
            bindings = <&kp TAB>;
            key-positions = <55 56>;
        };

        tl_bt-clr {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <18 17 16 15>;
        };

        tr_cad {
            bindings = <&kp LC(LA(DELETE))>;
            key-positions = <26 25 24 23>;
        };

        bl_alt+f4 {
            bindings = <&kp LA(F4)>;
            key-positions = <49 48 50>;
        };

        br_close-window {
            bindings = <&kp LC(W)>;
            key-positions = <57 56 55>;
        };

        l_reset {
            bindings = <&sys_reset>;
            key-positions = <18 50>;
        };

        r_reset {
            bindings = <&sys_reset>;
            key-positions = <55 23>;
        };

        l_bootloader {
            bindings = <&bootloader>;
            key-positions = <50 32 18>;
        };

        r_bootloader {
            bindings = <&bootloader>;
            key-positions = <55 41 23>;
        };

        l_key-repeat {
            bindings = <&key_repeat>;
            key-positions = <50 32>;
        };

        r_key-repeat {
            bindings = <&key_repeat>;
            key-positions = <55 41>;
        };

        l_caps-word {
            bindings = <&caps_word>;
            key-positions = <31 17>;
        };

        r_caps-word {
            bindings = <&caps_word>;
            key-positions = <42 24>;
        };

        l_capslock {
            bindings = <&kp CAPSLOCK>;
            key-positions = <30 16>;
        };

        r_capslock {
            bindings = <&kp CLCK>;
            key-positions = <43 25>;
        };

        l_insert {
            bindings = <&kp INSERT>;
            key-positions = <29 15>;
        };

        r_insert {
            bindings = <&kp INSERT>;
            key-positions = <44 26>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        resend {
            display-name = "Base";
            bindings = <
&none   &none            &none            &none               &none             &none  &none                                                         &none        &none  &none              &none                &none            &none            &none
&none   &kp Q            &hm RIGHT_ALT Y  &lt 11 G            &kp W             &none  &sys_reset                                                    &sys_reset   &none  &kp P              &lt 11 L             &hm RIGHT_ALT F  &kp P            &none
&none   &hm LEFT_META A  &hm LEFT_ALT I   &hm LEFT_CONTROL O  &hm LEFT_SHIFT E  &none  &bootloader  &none        &none        &none         &none    &bootloader  &none  &hm RIGHT_SHIFT D  &hm RIGHT_CONTROL N  &hm LEFT_ALT S   &hm RIGHT_GUI R  &none
&none   &none            &kp J            &lt 10 K            &lt 8 U           &none                            &none        &none                               &none  &lt 8 C            &lt 10 M             &kp B            &none            &none
&tog 1  &none            &none            &none               &none                    &lt 4 V      &lt 2 SPACE  &lt 6 X      &lt 7 DELETE  &lt 3 T  &lt 5 H             &none              &none                &none            &none            &tog 1
            >;
        };

        qwerty {
            display-name = "Base";
            bindings = <
&kp EQUAL         &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &none                                                    &none      &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB           &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y   &kp U   &kp I      &kp O     &kp P     &kp BSLH
&hm LCTRL ESCAPE  &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT         &none      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&tog 1            &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp SPACE          &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &tog 1
            >;
        };

        num_l {
            display-name = "num_l";
            bindings = <
&none   &none      &none   &none   &none   &none  &none                                         &none     &none  &none         &none   &none   &none      &none
&none   &kp MINUS  &kp N7  &kp N8  &kp N9  &none  &none                                         &none     &none  &kp N7        &kp N8  &kp N9  &kp EQUAL  &none
&none   &kp N0     &kp N4  &kp N5  &kp N6  &none  &none     &none   &none       &none   &none   &none     &none  &kp NUMBER_4  &kp N5  &kp N6  &kp N0     &none
&none   &none      &kp N1  &kp N2  &kp N3  &none                    &none       &none                     &none  &kp NUMBER_1  &kp N2  &kp N3  &none      &none
&tog 1  &none      &none   &none   &none          &double0  &kp N0  &trans      &trans  &kp N0  &double0         &none         &none   &none   &none      &tog 1
            >;
        };

        num_r {
            display-name = "num_r";
            bindings = <
&none   &none       &none   &none   &none   &none  &none                                                    &none     &none  &none         &none   &none   &none       &none
&none   &kp LSHIFT  &kp N7  &kp N8  &kp N9  &none  &none                                                    &none     &none  &kp N7        &kp N8  &kp N9  &kp RSHIFT  &none
&none   &kp N0      &kp N4  &kp N5  &kp N6  &none  &none     &none   &none              &none       &none   &none     &none  &kp NUMBER_4  &kp N5  &kp N6  &kp N0      &none
&none   &none       &kp N1  &kp N2  &kp N3  &none                    &none              &none                         &none  &kp NUMBER_1  &kp N2  &kp N3  &none       &none
&tog 1  &none       &none   &none   &none          &double0  &kp N0  &kp BACKSPACE      &kp DELETE  &kp N0  &double0         &none         &none   &none   &none       &tog 1
            >;
        };

        nav_l {
            bindings = <
&none   &none              &none               &none                   &none               &none  &none                                       &none   &none  &none                 &none                    &none                   &none              &none
&none   &hm LEFT_GUI HOME  &hm LEFT_ALT PG_DN  &hm LEFT_CONTROL PG_UP  &hm LEFT_SHIFT END  &none  &none                                       &none   &none  &hm RIGHT_SHIFT HOME  &hm RIGHT_CONTROL PG_UP  &hm LEFT_ALT PAGE_DOWN  &hm RIGHT_GUI END  &none
&none   &kp LEFT           &kp DOWN            &kp UP                  &kp RIGHT           &none  &none   &none   &none       &none   &none   &none   &none  &kp LEFT              &kp UP                   &kp DOWN                &kp RIGHT          &none
&none   &none              &kp LEFT            &kp DOWN                &kp RIGHT           &none                  &none       &none                   &none  &kp LEFT              &kp DOWN                 &kp RIGHT               &none              &none
&tog 1  &none              &none               &none                   &none                      &trans  &trans  &trans      &trans  &trans  &trans         &none                 &none                    &none                   &none              &tog 1
            >;
        };

        nav_r {
            bindings = <
&none   &none              &none               &none                   &none               &none  &none                                       &none   &none  &none                 &none                    &none                   &none              &none
&none   &hm LEFT_GUI HOME  &hm LEFT_ALT PG_DN  &hm LEFT_CONTROL PG_UP  &hm LEFT_SHIFT END  &none  &none                                       &none   &none  &hm RIGHT_SHIFT HOME  &hm RIGHT_CONTROL PG_UP  &hm LEFT_ALT PAGE_DOWN  &hm RIGHT_GUI END  &none
&none   &kp LEFT           &kp DOWN            &kp UP                  &kp RIGHT           &none  &none   &none   &none       &none   &none   &none   &none  &kp LEFT              &kp UP                   &kp DOWN                &kp RIGHT          &none
&none   &none              &kp LEFT            &kp DOWN                &kp RIGHT           &none                  &none       &none                   &none  &kp LEFT              &kp DOWN                 &kp RIGHT               &none              &none
&tog 1  &none              &none               &none                   &none                      &trans  &trans  &trans      &trans  &trans  &trans         &none                 &none                    &none                   &none              &tog 1
            >;
        };

        func1_l {
            display-name = "func1_l";
            bindings = <
&none   &none    &none   &none   &none   &none  &none                                       &none   &none  &none   &none   &none   &none    &none
&none   &mo 10   &kp F7  &kp F8  &kp F9  &none  &none                                       &none   &none  &kp F7  &kp F8  &kp F9  &mo 10   &none
&none   &kp F10  &kp F4  &kp F5  &kp F6  &none  &none   &none   &none       &none   &none   &none   &none  &kp F4  &kp F5  &kp F6  &kp F10  &none
&none   &none    &kp F1  &kp F2  &kp F3  &none                  &none       &none                   &none  &kp F1  &kp F2  &kp F3  &none    &none
&tog 1  &none    &none   &none   &none          &trans  &trans  &trans      &trans  &trans  &trans         &none   &none   &none   &none    &tog 1
            >;
        };

        func1_r {
            display-name = "func1_r";
            bindings = <
&none   &none    &none   &none   &none   &none  &none                                       &none   &none  &none   &none   &none   &none    &none
&none   &mo 10   &kp F7  &kp F8  &kp F9  &none  &none                                       &none   &none  &kp F7  &kp F8  &kp F9  &mo 10   &none
&none   &kp F10  &kp F4  &kp F5  &kp F6  &none  &none   &none   &none       &none   &none   &none   &none  &kp F4  &kp F5  &kp F6  &kp F10  &none
&none   &none    &kp F1  &kp F2  &kp F3  &none                  &none       &none                   &none  &kp F1  &kp F2  &kp F3  &none    &none
&tog 1  &none    &none   &none   &none          &trans  &trans  &trans      &trans  &trans  &trans         &none   &none   &none   &none    &tog 1
            >;
        };

        sym {
            display-name = "sym";
            bindings = <
&none   &none          &none       &none       &none       &none  &none                                       &none   &none  &none       &none       &none       &none          &none
&none   &kp LS(MINUS)  &kp LS(N7)  &kp LS(N8)  &kp LS(N9)  &none  &none                                       &none   &none  &kp RS(N7)  &kp RS(N8)  &kp RS(N9)  &kp RS(EQUAL)  &none
&none   &kp LS(N0)     &kp LS(N4)  &kp LS(N5)  &kp LS(N6)  &none  &none   &none   &none       &none   &none   &none   &none  &kp RS(N4)  &kp RS(N5)  &kp RS(N6)  &kp RS(N0)     &none
&none   &none          &kp LS(N1)  &kp LS(N2)  &kp LS(N3)  &none                  &none       &none                   &none  &kp RS(N1)  &kp RS(N2)  &kp RS(N3)  &none          &none
&tog 1  &none          &none       &none       &none              &trans  &trans  &trans      &trans  &trans  &trans         &none       &none       &none       &none          &tog 1
            >;
        };

        ctrl+nav {
            bindings = <
&none   &none                  &none                   &none                       &none                   &none  &none                                       &none   &none  &none                     &none                        &none                       &none                  &none
&none   &hm LEFT_GUI LC(HOME)  &hm LEFT_ALT LC(PG_DN)  &hm LEFT_CONTROL LC(PG_UP)  &hm LEFT_SHIFT LC(END)  &none  &none                                       &none   &none  &hm RIGHT_SHIFT RC(HOME)  &hm RIGHT_CONTROL RC(PG_UP)  &hm LEFT_ALT RC(PAGE_DOWN)  &hm RIGHT_GUI RC(END)  &none
&none   &kp LC(LEFT)           &kp LC(DOWN)            &kp LC(UP)                  &kp LC(RIGHT)           &none  &none   &none   &none       &none   &none   &none   &none  &kp RC(LEFT)              &kp RC(UP)                   &kp RC(DOWN)                &kp RC(RIGHT)          &none
&none   &none                  &kp LC(LEFT)            &kp LC(DOWN)                &kp LC(RIGHT)           &none                  &none       &none                   &none  &kp RC(LEFT)              &kp RC(DOWN)                 &kp RC(RIGHT)               &none                  &none
&tog 1  &none                  &none                   &none                       &none                          &trans  &trans  &trans      &trans  &trans  &trans         &none                     &none                        &none                       &none                  &tog 1
            >;
        };

        func2 {
            display-name = "func2";
            bindings = <
&none   &none    &none    &none    &none    &none  &none                                       &none   &none  &none    &none    &none    &none    &none
&none   &kp F21  &kp F17  &kp F18  &kp F19  &none  &none                                       &none   &none  &kp F17  &kp F18  &kp F19  &kp F21  &none
&none   &kp F20  &kp F14  &kp F15  &kp F16  &none  &none   &none   &none       &none   &none   &none   &none  &kp F14  &kp F15  &kp F16  &kp F20  &none
&none   &none    &kp F11  &kp F12  &kp F13  &none                  &none       &none                   &none  &kp F11  &kp F12  &kp F13  &none    &none
&tog 1  &none    &none    &none    &none           &trans  &trans  &trans      &trans  &trans  &trans         &none    &none    &none    &none    &tog 1
            >;
        };

        bluetooth {
            bindings = <
&none  &none         &none         &none         &none         &none  &none                                  &none  &none  &none         &none         &none         &none         &none
&none  &bt BT_SEL 4  &bt BT_CLR    &bt BT_PRV    &bt BT_NXT    &none  &none                                  &none  &none  &bt BT_PRV    &bt BT_NXT    &bt BT_CLR    &bt BT_SEL 4  &none
&none  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none  &none  &none  &none      &none  &none  &none  &none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &none
&none  &kp C_VOL_DN  &kp C_VOL_UP  &kp K_MUTE    &none         &none                &none      &none                &none  &kp K_MUTE    &kp C_VOL_UP  &kp C_VOL_DN  &none         &none
&none  &none         &none         &none         &none                &none  &none  &none      &none  &none  &none         &none         &none         &none         &none         &none
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        lr_func {
            if-layers = <6 7>;
            then-layer = <10>;
        };

        lr_num {
            if-layers = <2 3>;
            then-layer = <8>;
        };

        lr_nav {
            if-layers = <4 5>;
            then-layer = <9>;
        };
    };
};
