    keymap {
        compatible = "zmk,keymap";

        bougie {
            display-name = "Base";
            bindings = <
&tog 1  &none       &none      &none      &none      &none  &none                                                &none        &none  &none      &none      &none      &none    &tog 1
&none   &kp TAB     &kp E      &kp A      &kp T      &none  &sys_reset                                           &sys_reset   &none  &kp T      &kp A      &kp E      &kp TAB  &none
&none   &kp ESCAPE  &kp I      &kp O      &kp N      &none  &bootloader  &none      &none      &none  &none      &bootloader  &none  &kp N      &kp O      &kp I      &kp ESC  &none
&none   &none       &kp LC(X)  &kp LC(C)  &kp LC(V)  &none                          &none      &none                          &none  &kp LC(V)  &kp LC(C)  &kp LC(X)  &none    &none
&tog 2  &none       &none      &none      &none             &kp BSPC     &kp SPACE  &mo 0      &mo 0  &kp SPACE  &kp BSPC            &none      &none      &none      &none    &tog 2
            >;
        };

        typing {
            display-name = "typing";
            bindings = <
&tog 1  &none  &none   &none   &none   &none  &none                                          &none        &none  &none   &none   &none   &none  &tog 1
&none   &none  &trans  &trans  &trans  &none  &sys_reset                                     &sys_reset   &none  &trans  &trans  &trans  &none  &none
&none   &none  &trans  &trans  &trans  &none  &bootloader  &none   &none      &none  &none   &bootloader  &none  &trans  &trans  &trans  &none  &none
&none   &none  &none   &none   &none   &none                       &none      &none                       &none  &none   &none   &none   &none  &none
&none   &none  &none   &none   &none          &trans       &trans  &none      &none  &trans  &trans              &none   &none   &none   &none  &none
            >;
        };

        qwerty {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &none                                                    &none      &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y   &kp U   &kp I      &kp O     &kp P     &kp RET
&none      &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&tog 2     &kp GRAVE  &kp BSLH  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp SPACE          &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &tog 2
            >;
        };

        nav {
            display-name = "nav";
            bindings = <
&none  &none     &none      &none      &none      &none  &none                                     &none   &none  &none     &none      &none      &none      &none
&none  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &none  &none                                     &none   &none  &kp HOME  &kp PG_UP  &kp PG_DN  &kp END    &none
&none  &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &none  &none   &none   &none      &none  &none   &none   &none  &kp LEFT  &kp UP     &kp DOWN   &kp RIGHT  &none
&none  &none     &kp LEFT   &kp DOWN   &kp RIGHT  &none                  &none      &none                  &none  &kp LEFT  &kp DOWN   &kp RIGHT  &none      &none
&none  &none     &none      &none      &none             &trans  &trans  &none      &none  &trans  &trans         &none     &none      &none      &none      &none
