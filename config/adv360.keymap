#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

&gresc { keep-mods = <(MOD_LSFT|MOD_RSFT)>; };

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <100>;
            require-prior-idle-ms = <100>;
        };

        tl: tapping_layers {
            compatible = "zmk,behavior-hold-tap";
            label = "TAPPING_LAYERS";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            quick-tap-ms = <100>;
            require-prior-idle-ms = <100>;
        };

        u_paste: u_paste {
            compatible = "zmk,behavior-mod-morph";
            label = "U_PASTE";
            bindings = <&tap_u_qu>, <&kp LC(V)>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        p_copy: p_copy {
            compatible = "zmk,behavior-mod-morph";
            label = "P_COPY";
            bindings = <&kp P>, <&kp LC(C)>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        x_cut: x_cut {
            compatible = "zmk,behavior-mod-morph";
            label = "X_CUT";
            bindings = <&kp X>, <&kp LC(X)>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        the: the {
            compatible = "zmk,behavior-mod-morph";
            label = "THE";
            bindings = <&lthe>, <&uThe>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        from: from {
            compatible = "zmk,behavior-mod-morph";
            label = "FROM";
            bindings = <&lfrom>, <&uFrom>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        have: have {
            compatible = "zmk,behavior-mod-morph";
            label = "HAVE";
            bindings = <&lhave>, <&uHave>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        because: because {
            compatible = "zmk,behavior-mod-morph";
            label = "BECAUSE";
            bindings = <&lbecause>, <&uBecause>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        their: their {
            compatible = "zmk,behavior-mod-morph";
            label = "THEIR";
            bindings = <&ltheir>, <&uTheir>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        there: there {
            compatible = "zmk,behavior-mod-morph";
            label = "THERE";
            bindings = <&lthere>, <&uThere>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        theyre: theyre {
            compatible = "zmk,behavior-mod-morph";
            label = "THEYRE";
            bindings = <&ltheyre>, <&uTheyre>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        where: where {
            compatible = "zmk,behavior-mod-morph";
            label = "WHERE";
            bindings = <&lwhere>, <&uWhere>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        will: will {
            compatible = "zmk,behavior-mod-morph";
            label = "WILL";
            bindings = <&lwill>, <&uWill>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        would: would {
            compatible = "zmk,behavior-mod-morph";
            label = "WOULD";
            bindings = <&uWould>, <&uWould>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        aint: aint {
            compatible = "zmk,behavior-mod-morph";
            label = "AINT";
            bindings = <&laint>, <&uAint>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        yall: yall {
            compatible = "zmk,behavior-mod-morph";
            label = "YALL";
            bindings = <&lyall>, <&uYall>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        shant: shant {
            compatible = "zmk,behavior-mod-morph";
            label = "SHANT";
            bindings = <&lshant>, <&uShant>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        layer_rpt: layer_rpt {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_RPT";
            bindings = <&mo>, <&key_repeat>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        tap_u_qu: tap_u_qu {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_U_QU";
            #binding-cells = <0>;
            bindings = <&kp U>, <&qu>;

            tapping-term-ms = <200>;
        };

        qu: qu {
            compatible = "zmk,behavior-mod-morph";
            label = "QU";
            bindings = <&lqu>, <&uQu>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        please: please {
            compatible = "zmk,behavior-mod-morph";
            label = "PLEASE";
            bindings = <&lplease>, <&uPlease>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        thankyou: thankyou {
            compatible = "zmk,behavior-mod-morph";
            label = "THANKYOU";
            bindings = <&lthankyou>, <&uThankYou>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        comma_copy: comma_copy {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_COPY";
            bindings = <&comma_dot>, <&kp LC(C)>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        comma_dot: comma_dot {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_DOT";
            bindings = <&kp COMMA>, <&kp DOT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        rpt_copy: rpt_copy {
            compatible = "zmk,behavior-mod-morph";
            label = "RPT_COPY";
            bindings = <&key_repeat>, <&kp LC(C)>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };
    };

    macros {
        ht: ht {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp H &kp T>;
            label = "HT";
        };

        double0: double0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &kp N0>;
            label = "DOUBLE0";
        };

        Th: Th {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(T) &kp H>;
            label = "TH";
        };

        lthe: lthe {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp H &kp E &kp SPACE>;
            label = "LTHE";
        };

        uThe: uThe {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(T) &kp H &kp E &kp SPACE>;
            label = "UTHE";
        };

        lhave: lhave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp H &kp A &kp V &kp E &kp SPACE>;
            label = "LHAVE";
        };

        uHave: uHave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(H) &kp A &kp V &kp E &kp SPACE>;
            label = "UHAVE";
        };

        lfrom: lfrom {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F &kp R &kp O &kp M &kp SPACE>;
            label = "LFROM";
        };

        uFrom: uFrom {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(F) &kp R &kp O &kp M &kp SPACE>;
            label = "UFROM";
        };

        lbecause: lbecause {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp B &kp E &kp C &kp A &kp U &kp S &kp E &kp SPACE>;
            label = "LBECAUSE";
        };

        uBecause: uBecause {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(B) &kp E &kp C &kp A &kp U &kp S &kp E &kp SPACE>;
            label = "UBECAUSE";
        };

        ltheir: ltheir {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp H &kp E &kp I &kp R &kp SPACE>;
            label = "LTHEIR";
        };

        uTheir: uTheir {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(T) &kp H &kp E &kp I &kp R &kp SPACE>;
            label = "UTHEIR";
        };

        lthere: lthere {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp H &kp E &kp R &kp E &kp SPACE>;
            label = "LTHERE";
        };

        uThere: uThere {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(T) &kp H &kp E &kp R &kp E &kp SPACE>;
            label = "UTHERE";
        };

        ltheyre: ltheyre {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp H &kp E &kp Y &kp SQT &kp R &kp E &kp SPACE>;
            label = "LTHEYRE";
        };

        uTheyre: uTheyre {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(T) &kp H &kp E &kp Y &kp SQT &kp R &kp E &kp SPACE>;
            label = "UTHEYRE";
        };

        lwhere: lwhere {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp W &kp H &kp E &kp R &kp E &kp SPACE>;
            label = "LWHERE";
        };

        uWhere: uWhere {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(W) &kp H &kp E &kp R &kp E &kp SPACE>;
            label = "UWHERE";
        };

        lwill: lwill {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp W &kp I &kp L &kp L &kp SPACE>;
            label = "LWILL";
        };

        uWill: uWill {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(W) &kp I &kp L &kp L &kp SPACE>;
            label = "UWILL";
        };

        lwould: lwould {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp W &kp O &kp U &kp L &kp D &kp SPACE>;
            label = "LWOULD";
        };

        uWould: uWould {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(W) &kp O &kp U &kp L &kp D &kp SPACE>;
            label = "UWOULD";
        };

        laint: laint {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp A &kp I &kp N &kp SQT &kp T &kp SPACE>;
            label = "LAINT";
        };

        uAint: uAint {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(A) &kp I &kp N &kp SQT &kp T &kp SPACE>;
            label = "UAINT";
        };

        lyall: lyall {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Y &kp SQT &kp A &kp L &kp L &kp SPACE>;
            label = "LYALL";
        };

        uYall: uYall {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(Y) &kp SQT &kp A &kp L &kp L &kp SPACE>;
            label = "UYALL";
        };

        lshant: lshant {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp H &kp A &kp N &kp SQT &kp T &kp SPACE>;
            label = "LSHANT";
        };

        uShant: uShant {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(S) &kp H &kp A &kp N &kp SQT &kp T &kp SPACE>;
            label = "USHANT";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        land: land {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp A &kp N &kp D>;
            label = "LAND";
        };

        uAnd: uAnd {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(A) &kp N &kp D>;
            label = "UAND";
        };

        lqu: lqu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Q &kp U>;
            label = "LQU";
        };

        uQu: uQu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(Q) &kp U>;
            label = "UQU";
        };

        uPlease: please {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(P) &kp L &kp E &kp A &kp S &kp E>;
            label = "PLEASE";
        };

        lplease: lplease {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp P &kp L &kp E &kp A &kp S &kp E>;
            label = "LPLEASE";
        };

        uThankYou: uThankYou {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(T) &kp H &kp A &kp N &kp K &kp SPACE &kp Y &kp O &kp U>;
            label = "UTHANKYOU";
        };

        lthankyou: lthankyou {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp H &kp A &kp N &kp K &kp SPACE &kp Y &kp O &kp U>;
            label = "LTHANKYOU";
        };
    };

    combos {
        compatible = "zmk,combos";

        tl_sl-bt {
            bindings = <&sl 7>;
            key-positions = <17 16>;
        };

        tl_ret {
            bindings = <&kp RETURN>;
            key-positions = <16 18>;
        };

        tl_sl-sym {
            bindings = <&sl 10>;
            key-positions = <17 18>;
        };

        tr_sl-bt {
            bindings = <&sl 7>;
            key-positions = <25 24>;
        };

        tr_ret {
            bindings = <&kp RETURN>;
            key-positions = <25 23>;
        };

        tr_sl-sym {
            bindings = <&sl 10>;
            key-positions = <23 24>;
        };

        hl_apos {
            bindings = <&kp APOS>;
            key-positions = <30 29>;
            layers = <0 2 3 4>;
        };

        hl_bslash {
            bindings = <&kp BSLH>;
            key-positions = <29 31>;
            layers = <0 2 3 4>;
        };

        hl_semi {
            bindings = <&kp SEMI>;
            key-positions = <29 32>;
            layers = <0 2 3 4>;
        };

        hl_under {
            bindings = <&kp UNDER>;
            key-positions = <30 31>;
            layers = <0 2 3 4>;
        };

        hl_question {
            bindings = <&kp QUESTION>;
            key-positions = <30 32>;
            layers = <0 2 3 4>;
        };

        hl_comma {
            bindings = <&kp COMMA>;
            key-positions = <32 31>;
            layers = <0 2 3 4>;
        };

        hr_dqt {
            bindings = <&kp DQT>;
            key-positions = <44 43>;
            layers = <0 2 3 4>;
        };

        hr_slash {
            bindings = <&kp SLASH>;
            key-positions = <44 42>;
            layers = <0 2 3 4>;
        };

        hr_colon {
            bindings = <&kp COLON>;
            key-positions = <41 44>;
            layers = <0 2 3 4>;
        };

        hr_minus {
            bindings = <&kp MINUS>;
            key-positions = <43 42>;
            layers = <0 2 3 4>;
        };

        hr_exclam {
            bindings = <&kp EXCLAMATION>;
            key-positions = <43 41>;
            layers = <0 2 3 4>;
        };

        hr_rparen {
            bindings = <&kp DOT>;
            key-positions = <42 41>;
            layers = <0 2 3 4>;
        };

        bl_del {
            bindings = <&kp DELETE>;
            key-positions = <48 49>;
        };

        bl_gresc {
            bindings = <&gresc>;
            key-positions = <48 50>;
        };

        bl_bpsc {
            bindings = <&kp BSPC>;
            key-positions = <49 50>;
        };

        br_del {
            bindings = <&kp DELETE>;
            key-positions = <57 56>;
        };

        br_gresc {
            bindings = <&gresc>;
            key-positions = <57 55>;
        };

        br_bspc {
            bindings = <&kp BSPC>;
            key-positions = <56 55>;
        };

        vtl_less {
            bindings = <&kp LESS_THAN>;
            key-positions = <29 15 65 66>;
        };

        vtl_bracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <30 16>;
        };

        vtl_brace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <31 17>;
        };

        vtl_paren {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <32 18>;
        };

        vtr_more {
            bindings = <&kp GREATER_THAN>;
            key-positions = <44 26>;
        };

        vtr_bracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <43 25>;
        };

        vtr_brace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <42 24>;
        };

        vtr_paren {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <41 23>;
        };

        vbl_os-lalt {
            bindings = <&sk LALT>;
            key-positions = <48 30>;
        };

        vbl_os-lctl {
            bindings = <&sk LCTRL>;
            key-positions = <49 31>;
        };

        vbl_os-lshift {
            bindings = <&sk LSHIFT>;
            key-positions = <50 32>;
        };

        vbr_os-lalt {
            bindings = <&sk LALT>;
            key-positions = <43 57>;
        };

        vbr_sk-rctrl {
            bindings = <&sk RCTRL>;
            key-positions = <56 42>;
        };

        vbr_sk-rshift {
            bindings = <&sk RSHFT>;
            key-positions = <55 41>;
        };

        sthl_qu {
            bindings = <&kp Q>;
            key-positions = <32 17>;
        };

        shtl_plus {
            bindings = <&kp J>;
            key-positions = <31 18>;
        };

        sthl_pipe {
            bindings = <&kp PIPE>;
            key-positions = <16 31>;
        };

        shtl_amp {
            bindings = <&kp AMPS>;
            key-positions = <30 17>;
        };

        shtr_p {
            bindings = <&kp Z>;
            key-positions = <41 24>;
        };

        sthr_x {
            bindings = <&kp X>;
            key-positions = <23 42>;
        };

        shtr_p {
            bindings = <&kp P>;
            key-positions = <42 55>;
        };

        sthr_w {
            bindings = <&kp W>;
            key-positions = <41 56>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        k_bye {
            display-name = "Base";
            bindings = <
&tog 1  &none        &none            &none               &none             &none  &none                                                     &none        &none  &none              &none                &none            &none        &tog 1
&none   &kp TAB      &hm RIGHT_ALT K  &tl 12 B            &tl 10 Y          &none  &sys_reset                                                &sys_reset   &none  &tl 10 C           &tl 12 L             &hm RIGHT_ALT F  &kp TAB      &none
&none   &hm LMETA A  &mt LEFT_ALT I   &hm LEFT_CONTROL O  &hm LEFT_SHIFT E  &none  &bootloader     &none        &none       &none   &none    &bootloader  &none  &hm RIGHT_SHIFT D  &hm RIGHT_CONTROL N  &hm LEFT_ALT S   &hm RMETA R  &none
&none   &none        &x_cut           &rpt_copy           &u_paste          &none                               &none       &none                         &none  &kp G              &kp M                &kp V            &none        &none
&tog 2  &none        &none            &none               &none                    &layer_rpt 3 0  &tl 5 SPACE  &mo 10      &mo 10  &tl 6 T  &tl 4 H             &none              &none                &none            &none        &tog 2
            >;
        };

        typing {
            display-name = "typing";
            bindings = <
&tog 1  &none  &none  &none  &none  &none  &none                                             &none        &none  &none  &none  &none  &none  &tog 1
&none   &kp J  &kp K  &kp B  &kp Y  &none  &sys_reset                                        &sys_reset   &none  &kp C  &kp L  &kp F  &kp W  &none
&none   &kp A  &kp I  &kp O  &kp E  &none  &bootloader  &none      &none       &none  &none  &bootloader  &none  &kp D  &kp N  &kp S  &kp R  &none
&none   &none  &kp X  &kp P  &kp U  &none                          &none       &none                      &none  &kp G  &kp M  &kp V  &none  &none
&none   &none  &none  &none  &none         &key_repeat  &kp SPACE  &mo 10      &mo 4  &kp T  &kp H               &none  &none  &none  &none  &none
            >;
        };

        qwerty {
            display-name = "Base";
            bindings = <
&kp EQUAL         &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &none                                                    &none      &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB           &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y   &kp U   &kp I      &kp O     &kp P     &kp RET
&hm LCTRL ESCAPE  &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT         &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&tog 2            &kp GRAVE  &kp BSLH  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp SPACE          &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &tog 2
            >;
        };

        num_l {
            display-name = "num_l";
