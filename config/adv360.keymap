&gresc { keep-mods = <(MOD_LSFT|MOD_RSFT)>; };

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        Numlock: Numlock {
            compatible = "zmk,behavior-tap-dance";
            label = "NUMLOCK";
            #binding-cells = <0>;
            bindings = <&sl 3>, <&tog 3>;
        };

        Navlock: Navlock {
            compatible = "zmk,behavior-tap-dance";
            label = "NAVLOCK";
            #binding-cells = <0>;
            bindings = <&sl 4>, <&tog 4>;
        };
    };

