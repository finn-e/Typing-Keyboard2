#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>


/* =========================
 *  BOUGIE KEYS — LEFT HAND
 *  Rows: Top=row 3, Home=row 2, Bottom=row 1
 *  Columns used on left: 1..4
 * ========================= */
#define TLP 15  /* RC(3,1)  top-left pinky   */
#define TLR 16  /* RC(3,2)  top-left ring    */
#define TLM 17  /* RC(3,3)  top-left middle  */
#define TLI 18  /* RC(3,4)  top-left index   */

#define HLP 29  /* RC(2,1)  home-left pinky  */
#define HLR 30  /* RC(2,2)  home-left ring   */
#define HLM 31  /* RC(2,3)  home-left middle */
#define HLI 32  /* RC(2,4)  home-left index  */

#define BLP 47  /* RC(1,1)  bottom-left pinky */
#define BLR 48  /* RC(1,2)  bottom-left ring  */
#define BLM 49  /* RC(1,3)  bottom-left middle*/
#define BLI 50  /* RC(1,4)  bottom-left index */

/* =========================
 *  BOUGIE KEYS — RIGHT HAND
 *  Rows: Top=row 3, Home=row 2, Bottom=row 1
 *  Right side ordered outer→inner: cols 19..16
 * ========================= */
#define TRP 26  /* RC(3,19) top-right pinky  */
#define TRR 25  /* RC(3,18) top-right ring   */
#define TRM 24  /* RC(3,17) top-right middle */
#define TRI 23  /* RC(3,16) top-right index  */

#define HRP 44  /* RC(2,19) home-right pinky */
#define HRR 43  /* RC(2,18) home-right ring  */
#define HRM 42  /* RC(2,17) home-right middle*/
#define HRI 41  /* RC(2,16) home-right index */

#define BRP 58  /* RC(1,19) bottom-right pinky */
#define BRR 57  /* RC(1,18) bottom-right ring  */
#define BRM 56  /* RC(1,17) bottom-right middle*/
#define BRI 55  /* RC(1,16) bottom-right index */

/* =========================
 *  THUMBS — 3 per hand (inner, outer, center)
 *  Left:  RC(0,9)=inner, RC(0,7)=outer, RC(0,8)=center
 *  Right: mirror → RC(0,16)=inner, RC(0,15)=outer, RC(0,17)=center
 * ========================= */
#define LIT 67  /* RC(0,9)  left inner thumb  */
#define LOT 65  /* RC(0,7)  left outer thumb  */
#define LCT 66  /* RC(0,8)  left center thumb */

#define RIT 68  /* RC(0,16) right inner thumb */
#define ROT 70  /* RC(0,15) right outer thumb */
#define RCT 69  /* RC(0,17) right center thumb */

/* =========================
 *  FUTURE THUMBS: T4 / T5 / T6
 *  T4: row 1, center  → RC(1,9) / RC(1,10)
 *  T5: row 2, center  → RC(2,8) / RC(2,11)
 *  T6: row 2, center  → RC(2,9) / RC(2,10)
 * ========================= */
#define L4T 52  /* RC(1,9)  left T4 */
#define R4T 53  /* RC(1,10) right T4 */

#define L5T 35  /* RC(2,8)  left T5 */
#define R5T 38  /* RC(2,11) right T5 */

#define L6T 36  /* RC(2,9)  left T6 */
#define R6T 37  /* RC(2,10) right T6 */

// LAYERS
#define BOU  0
#define JKB  1
#define QWE  2
#define NAV  3
#define WIN  4
#define DESK 5
#define NUM  6
#define BT   7

// CONFIG
#define COMBO_TIMEOUT 70
#define COMBO_LAYERS BOU NAV WIN DESK NUM BT
#define STICKY_TIMEOUT 1000
#define QUICK_TAP_TIMEOUT 125
#define HOLD_TAP_TIMEOUT 195

&gresc { keep-mods = <(MOD_LSFT|MOD_RSFT)>; };

/ {
    behaviors {
        #include "behaviors.dtsi"
        #include "kinesis_macros.dtsi"
        #include "version.dtsi"
    };

    macros {
        #include "macros.dtsi"
    };

    combos {
        compatible = "zmk,combos";
        #include "combos.dtsi"
    };

    keymap {
        compatible = "zmk,keymap";

        bougie {
            display-name = "BOUGIE";
            bindings = <
&tog 1  &none       &none  &none  &none  &bt BT_SEL 0  &bt BT_CLR                                                             &bt BT_CLR       &bt BT_SEL 0  &none  &none  &none  &none      &tog 1
&none   &sk LCTRL   &as R  &as O  &as D  &bt BT_SEL 1  &sys_reset                                                             &sys_reset       &bt BT_SEL 1  &as D  &as O  &as R  &sk LCTRL  &none
&none   &sk LSHIFT  &as N  &as E  &as T  &bt BT_SEL 2  &bootloader      &none        &none           &none       &none        &bootloader      &bt BT_SEL 2  &as T  &as E  &as N  &sk LSHFT  &none
&none   &sk LMETA   &as H  &as A  &as S  &bt BT_SEL 3                                &lt 8 TAB       &lt 8 TAB                                 &bt BT_SEL 3  &as S  &as A  &as H  &sk LMETA  &none
&tog 2  &none       &none  &none  &none                &lt 3 BACKSPACE  &lt 5 SPACE  &lt 10 RET      &lt 10 RET  &lt 6 SPACE  &lt 4 BACKSPACE                &none  &none  &none  &none      &tog 2
            >;
        };

        jkbye {
            display-name = "JKBYE";
            bindings = <
&tog 1  &none  &none  &none  &none  &none  &none                                             &none        &none  &none  &none  &none  &none  &tog 1
&none   &as J  &as K  &as B  &as Y  &none  &sys_reset                                        &sys_reset   &none  &as C  &as L  &as F  &as W  &none
&none   &as A  &as I  &as O  &as E  &none  &bootloader  &none      &none       &none  &none  &bootloader  &none  &as D  &as N  &as S  &as R  &none
&none   &none  &as X  &as P  &as U  &none                          &none       &none                      &none  &as G  &as M  &as V  &none  &none
&none   &none  &none  &none  &none         &key_repeat  &kp SPACE  &mo 10      &mo 4  &as T  &as H               &none  &none  &none  &none  &none
            >;
        };

        qwerty {
            display-name = "QWERTY";
            bindings = <
&kp EQUAL         &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &none                                                    &none      &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB           &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y   &kp U   &kp I      &kp O     &kp P     &kp RET
&mt LCTRL ESCAPE  &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT         &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&tog 2            &kp GRAVE  &kp BSLH  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp SPACE          &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &tog 2
            >;
        };

        num_l {
            display-name = "num_l";
            bindings = <
&none  &none                 &none   &none   &none   &none  &none                                     &none   &none  &none         &none   &none   &none                  &none
&none  &mt LEFT_SHIFT MINUS  &kp N7  &kp N8  &kp N9  &none  &none                                     &none   &none  &kp N7        &kp N8  &kp N9  &mt RIGHT_SHIFT EQUAL  &none
&none  &kp N0                &kp N4  &kp N5  &kp N6  &none  &none   &none   &none      &none  &none   &none   &none  &kp NUMBER_4  &kp N5  &kp N6  &kp N0                 &none
&none  &none                 &kp N1  &kp N2  &kp N3  &none                  &none      &none                  &none  &kp NUMBER_1  &kp N2  &kp N3  &none                  &none
&none  &none                 &none   &none   &none          &trans  &trans  &none      &none  &trans  &trans         &none         &none   &none   &none                  &none
            >;
        };

        num_r {
            display-name = "num_r";
            bindings = <
&none  &none             &none   &none   &none   &none  &none                                     &none   &none  &none         &none   &none   &none             &none
&none  &mt LSHIFT MINUS  &kp N7  &kp N8  &kp N9  &none  &none                                     &none   &none  &kp N7        &kp N8  &kp N9  &mt RSHIFT EQUAL  &none
&none  &kp N0            &kp N4  &kp N5  &kp N6  &none  &none   &none   &none      &none  &none   &none   &none  &kp NUMBER_4  &kp N5  &kp N6  &kp N0            &none
&none  &none             &kp N1  &kp N2  &kp N3  &none                  &none      &none                  &none  &kp NUMBER_1  &kp N2  &kp N3  &none             &none
&none  &none             &none   &none   &none          &trans  &trans  &none      &none  &trans  &trans         &none         &none   &none   &none             &none
            >;
        };

        nav_l {
            bindings = <
&none  &none              &none               &none                   &none               &none  &none                                     &none   &none  &none                 &none                    &none                   &none              &none
&none  &mt LEFT_GUI HOME  &mt LEFT_ALT PG_DN  &mt LEFT_CONTROL PG_UP  &mt LEFT_SHIFT END  &none  &none                                     &none   &none  &mt RIGHT_SHIFT HOME  &mt RIGHT_CONTROL PG_UP  &mt LEFT_ALT PAGE_DOWN  &mt RIGHT_GUI END  &none
&none  &kp LEFT           &kp DOWN            &kp UP                  &kp RIGHT           &none  &none   &none   &none      &none  &none   &none   &none  &kp LEFT              &kp UP                   &kp DOWN                &kp RIGHT          &none
&none  &none              &kp LEFT            &kp DOWN                &kp RIGHT           &none                  &none      &none                  &none  &kp LEFT              &kp DOWN                 &kp RIGHT               &none              &none
&none  &none              &none               &none                   &none                      &trans  &trans  &none      &none  &trans  &trans         &none                 &none                    &none                   &none              &none
            >;
        };

        nav_r {
            bindings = <
&none  &none              &none               &none                   &none               &none  &none                                     &none   &none  &none                 &none                    &none                   &none              &none
&none  &mt LEFT_GUI HOME  &mt LEFT_ALT PG_DN  &mt LEFT_CONTROL PG_UP  &mt LEFT_SHIFT END  &none  &none                                     &none   &none  &mt RIGHT_SHIFT HOME  &mt RIGHT_CONTROL PG_UP  &mt LEFT_ALT PAGE_DOWN  &mt RIGHT_GUI END  &none
&none  &kp LEFT           &kp DOWN            &kp UP                  &kp RIGHT           &none  &none   &none   &none      &none  &none   &none   &none  &kp LEFT              &kp UP                   &kp DOWN                &kp RIGHT          &none
&none  &none              &kp LEFT            &kp DOWN                &kp RIGHT           &none                  &none      &none                  &none  &kp LEFT              &kp DOWN                 &kp RIGHT               &none              &none
&none  &none              &none               &none                   &none                      &trans  &trans  &none      &none  &trans  &trans         &none                 &none                    &none                   &none              &none
            >;
        };

        bt {
            bindings = <
&none  &none         &none         &none         &none         &none  &none                                     &none   &none  &none         &none         &none         &none         &none
&none  &bt BT_CLR    &bt BT_PRV    &bt BT_NXT    &bt BT_SEL 4  &none  &none                                     &none   &none  &bt BT_SEL 4  &bt BT_PRV    &bt BT_NXT    &bt BT_CLR    &none
&none  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none  &none   &none   &none      &none  &none   &none   &none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &none
&none  &none         &kp C_VOL_DN  &kp K_MUTE    &kp C_VOL_UP  &none                  &none      &none                  &none  &kp C_VOL_UP  &kp K_MUTE    &kp C_VOL_DN  &none         &none
&none  &none         &none         &none         &none                &trans  &trans  &none      &none  &trans  &trans         &none         &none         &none         &none         &none
            >;
        };

        func1 {
            display-name = "func1";
            bindings = <
&none  &none             &none        &none         &none          &none  &none                                  &none  &none  &none          &none         &none        &none          &none
&none  &mt LEFT_GUI F22  &mt LALT F7  &mt LCTRL F8  &mt LSHIFT F9  &none  &none                                  &none  &none  &mt RSHIFT F7  &mt RCTRL F8  &mt LALT F9  &mt RMETA F22  &none
&none  &kp F10           &kp F4       &kp F5        &kp F6         &none  &none  &none  &none      &none  &none  &none  &none  &kp F4         &kp F5        &kp F6       &kp F10        &none
&none  &none             &kp F1       &kp F2        &kp F3         &none                &none      &none                &none  &kp F1         &kp F2        &kp F3       &none          &none
&none  &none             &none        &none         &none                 &mo 9  &mo 9  &none      &none  &mo 9  &mo 9         &none          &none         &none        &none          &none
            >;
        };

        func2 {
            display-name = "func2";
            bindings = <
&none  &none       &none    &none    &none    &none  &none                                     &none   &none  &none    &none    &none    &none       &none
&none  &caps_word  &kp F17  &kp F18  &kp F19  &none  &none                                     &none   &none  &kp F17  &kp F18  &kp F19  &caps_word  &none
&none  &kp F20     &kp F14  &kp F15  &kp F16  &none  &none   &none   &none      &none  &none   &none   &none  &kp F14  &kp F15  &kp F16  &kp F20     &none
&none  &none       &kp F11  &kp F12  &kp F13  &none                  &none      &none                  &none  &kp F11  &kp F12  &kp F13  &none       &none
&none  &none       &none    &none    &none           &trans  &trans  &none      &none  &trans  &trans         &none    &none    &none    &none       &none
            >;
        };

        btplus {
            display-name = "bt+";
            bindings = <
&none  &none          &none          &none           &none          &none  &none                                     &none   &none  &none         &none           &none          &none         &none
&none  &soft_off      &out OUT_TOG   &sys_reset      &bootloader    &none  &none                                     &none   &none  &bootloader   &sys_reset      &out OUT_TOG   &soft_off     &none
&none  &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2    &bt BT_SEL 3   &none  &none   &none   &none      &none  &none   &none   &none  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2   &bt BT_SEL 3  &none
&none  &none          &studio_unlock &bt BT_CLR_ALL  &bt BT_CLR     &none                  &none      &none                  &none  &bt BT_CLR    &bt BT_CLR_ALL  &studio_unlock &none         &none
&none  &none          &none          &none           &none                 &trans  &trans  &none      &none  &trans  &trans         &none         &none           &none          &none         &none
            >;
        };

        sym {
            display-name = "sym";
            bindings = <
&none  &none          &none       &none       &none       &none  &none                                     &none   &none  &none       &none       &none       &none          &none
&none  &kp LS(MINUS)  &kp LS(N7)  &kp LS(N8)  &kp LS(N9)  &none  &none                                     &none   &none  &kp RS(N7)  &kp RS(N8)  &kp RS(N9)  &kp RS(EQUAL)  &none
&none  &kp LS(N0)     &kp LS(N4)  &kp LS(N5)  &kp LS(N6)  &none  &none   &none   &none      &none  &none   &none   &none  &kp RS(N4)  &kp RS(N5)  &kp RS(N6)  &kp RS(N0)     &none
&none  &none          &kp LS(N1)  &kp LS(N2)  &kp LS(N3)  &none                  &none      &none                  &none  &kp RS(N1)  &kp RS(N2)  &kp RS(N3)  &none          &none
&none  &none          &none       &none       &none              &trans  &trans  &none      &none  &trans  &trans         &none       &none       &none       &none          &none
            >;
        };

        misc {
            bindings = <
&none  &none       &none              &none  &none           &none  &none                                                  &none        &none  &none           &none  &none              &none       &none
&none  &soft_off   &out OUT_TOG       &none  &studio_unlock  &none  &none                                                  &none        &none  &studio_unlock  &none  &out OUT_TOG       &soft_off   &none
&none  &sys_reset  &ext_power EP_TOG  &none  &bootloader     &none  &none        &none       &none      &none  &none       &none        &none  &bootloader     &none  &ext_power EP_TOG  &sys_reset  &none
&none  &none       &bt BT_CLR_ALL     &none  &bl BL_CYCLE    &none                           &none      &none                           &none  &bl BL_CYCLE    &none  &bt BT_CLR_ALL     &none       &none
&none  &none       &none              &none  &none                  &bootloader  &sys_reset  &none      &none  &sys_reset  &bootloader         &none           &none  &none              &none       &none
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        lr_num {
            if-layers = <3 4>;
            then-layer = <11>;
        };

        leftThumbs {
            if-layers = <5 3>;
            then-layer = <9>;
        };

        rightThumbs {
            if-layers = <6 4>;
            then-layer = <8>;
        };
    };
};
